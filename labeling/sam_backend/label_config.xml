<View>
  <Style>
    * {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    .lsf-header, .lsf-label, .lsf-controls {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif !important;
      letter-spacing: 0.2px;
    }
    /* Ẩn hoàn toàn hàng nhãn Polygon ngầm của SAM */
    .lsf-polygon-labels, [data-testid="polygonlabels"] { 
      display: none !important; 
    }
    
    /* Viền xanh ngọc đậm 2.2px kèm bóng đổ đen mỏng chống chìm nét trên mọi nền */
    svg path, svg polygon, svg rect {
      stroke-width: 2.2px !important;
      filter: drop-shadow(0px 0px 1px #000000) drop-shadow(0px 0px 1.5px rgba(0, 0, 0, 0.7)) !important;
    }

    /* Khóa màu hover: khi chạm chuột vào chữ, viền vẫn giữ màu xanh ngọc, không bị nhảy sang màu đỏ */
    svg path:hover, svg polygon:hover, svg rect:hover,
    svg [class*="highlighted"], svg [class*="selected"],
    .lsf-region_highlighted path, .lsf-region_highlighted polygon {
      stroke: #27ae60 !important;
      fill: rgba(39, 174, 96, 0.25) !important;
    }
  </Style>

  <!-- 1. Vùng hiển thị ảnh -->
  <Image name="image" value="$image" zoom="true" zoomBy="1.5" rotateControl="true"/>

  <!-- 2. Hàng nhãn: CỐ ĐỊNH MÃ MÀU XANH NGỌC #27ae60 -->
  <Header value="Chọn nhãn rồi kéo Box để SAM tự bọc viền:" style="font-size: 15px; font-weight: 600; color: #2d3748; margin: 6px 0 3px 0;"/>
  <RectangleLabels name="label" toName="image" smart="true" canRotate="false" choice="single">
    
    <Label value="Object" background="#27ae60"/>
  </RectangleLabels>

  <!-- 3. Thẻ ngầm SAM: KHÓA CÙNG MÃ MÀU #27ae60, ĐỘ MỜ LÒNG 15% -->
  <View style="display: none;">
    <PolygonLabels name="polygon" toName="image" strokeWidth="2" opacity="0.15" choice="single">
      
      <Label value="Object" background="#27ae60"/>
    </PolygonLabels>
  </View>
</View>